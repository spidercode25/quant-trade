# ==========================================
# Longbridge OpenAPI 凭证 (长桥证券 API)
# ==========================================
LONGPORT_APP_KEY=your_app_key_here
LONGPORT_APP_SECRET=your_app_secret_here
LONGPORT_ACCESS_TOKEN=your_access_token_here

# ==========================================
# 交易机器人配置
# ==========================================
# 股票池 (用半角逗号分隔，美股需要带 .US 后缀)
STOCK_POOL=SPY.US,AAPL.US,TSLA.US

# 高波动趋势型股票（未列出的高波动股票默认也走趋势型分支）
HIGH_VOL_TREND_STOCKS=OKLO.US,RIOT.US,TSLA.US,HOOD.US

# 高波动震荡型股票（更保守的回调反弹分支，不追突破、不加仓）
HIGH_VOL_OSCILLATORY_STOCKS=COIN.US,PDD.US

# ==========================================
# 模拟与测试选项
# ==========================================
# DRY_RUN 模拟运行：如果为 true 或未设置，系统会生成交易信号，更新本地状态，但不会真实提交订单。
# 如果设置为 false，系统将会使用上方的凭证进行【真实下单交易】（请确保账户资产充足，并谨慎操作）。
DRY_RUN=true

# FORCE_RUN 强制运行：系统默认在美东时间 09:45 - 16:00 期间交易，其余时间休眠。
# 在本地调试时，将其设为 true 即可忽略时间校验，立刻执行一次交易轮询。
FORCE_RUN=false
